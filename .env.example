# Vector API Configuration
# Required: Your Anthropic API key (separate from any other project keys)
VECTOR_ANTHROPIC_API_KEY=

# Optional: Override the default Claude model
# Default: claude-haiku-4-5-20251001
VECTOR_CLAUDE_MODEL=

# Stack AI page: base URL of the conversation API the /chat page talks to.
# Default: http://127.0.0.1:8790 (a local engine)
STACKAI_API_BASE=
